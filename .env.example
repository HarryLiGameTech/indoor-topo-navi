# PostgreSQL. docker compose provisions it with a persistent named volume; choose a strong password.
TOPONAVI_DB_PASSWORD=
# TOPONAVI_DB_NAME=toponavi
# TOPONAVI_DB_USER=toponavi

# Required opaque service credential (at least 32 characters). Clients such as the MCP server send it as
# "Authorization: Bearer <token>" (MCP: TOPONAVI_API_TOKEN). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit it or put it in a URL.
TOPONAVI_SERVICE_TOKEN=

# Optional explicit anonymous access (comma-separated exact building IDs) and guest validation.
TOPONAVI_ANONYMOUS_BUILDINGS=
TOPONAVI_ALLOW_GUEST_AUTHORING=false

# Host address and port for the published API. The default accepts connections only from this host.
# 0.0.0.0 accepts connections from other machines over plain HTTP, so the service token crosses the
# network unencrypted: prefer a private network (e.g. Tailscale) or a TLS reverse proxy.
# TOPONAVI_HOST_BIND=127.0.0.1
# TOPONAVI_HOST_PORT=8080

# Only for running the service outside compose, e.g. ./gradlew :toponavi-web:bootRun
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/toponavi
# SPRING_DATASOURCE_USERNAME=toponavi
# SPRING_DATASOURCE_PASSWORD=
